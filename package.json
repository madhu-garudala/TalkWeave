{
  "name": "talkweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "DATA_DIR=.test-data/unit tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "fixture": "tsx scripts/create-fixture.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:offline": "tsx scripts/check-offline.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json index.html"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
